import pandas as pd
from sklearn.mixture import GaussianMixture

data = pd.DataFrame({
    "Feature1": [1.0, 1.5, 2.0, 2.5, 3.0, 3.5, 8.0, 8.5, 9.0, 9.5, 10.0, 10.5],
    "Feature2": [2.0, 1.8, 2.2, 2.8, 3.2, 3.8, 8.5, 8.8, 9.2, 9.8, 10.2, 10.8]
})

model = GaussianMixture(n_components=2, random_state=42)

model.fit(data)

labels = model.predict(data)

print("Dataset\n")
print(data)

print("\nCluster Labels\n")
for i in range(len(labels)):
    print("Sample", i + 1, ":", labels[i])

new_sample = [[4.0, 4.2]]

prediction = model.predict(new_sample)

print("\nNew Sample")
print(new_sample)

print("\nPredicted Cluster")
print(prediction[0])
