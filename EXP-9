import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures

data = pd.read_csv("salary_experience.csv")

X = data[["Experience"]]
y = data["Salary"]

lr = LinearRegression()
lr.fit(X, y)

poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)

pr = LinearRegression()
pr.fit(X_poly, y)

print("Linear Prediction for 16 Years:")
print(lr.predict([[16]])[0])

print("\nPolynomial Prediction for 16 Years:")
print(pr.predict(poly.transform([[16]]))[0])

plt.scatter(X, y)
plt.plot(X, lr.predict(X), color="red", label="Linear")
plt.plot(X, pr.predict(X_poly), color="green", label="Polynomial")
plt.xlabel("Experience")
plt.ylabel("Salary")
plt.title("Linear vs Polynomial Regression")
plt.legend()
plt.show()
